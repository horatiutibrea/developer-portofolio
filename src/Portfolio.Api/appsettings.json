{
  "ConnectionStrings": {
    "DatabaseConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AuthSettings": {
    "SecretKey": "",
    "GoogleClientId": "",
    "JwtValidityInHours": 6,
    "Issuer": "ase-app-template",
    "Audience": "ase-app-template-frontend"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:4200"
    ]
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Database": {
    "FailOnPendingMigrations": true
  },
  "AllowedHosts": "*"
}
